{
  "name": "agenticerm-desktop",
  "version": "1.15.0",
  "description": "AgenticERM 데스크탑 앱 (Electron)",
  "author": "UXIS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "kr.co.uxis.agenticerm",
    "productName": "AgenticERM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "../index.html",
        "to": "index.html"
      },
      {
        "from": "../js",
        "to": "js"
      },
      {
        "from": "../css",
        "to": "css"
      },
      {
        "from": "../vendor",
        "to": "vendor"
      },
      {
        "from": "../splash",
        "to": "splash"
      }
    ],
    "extraResources": [
      {
        "from": "../proxy/python/dist/uxer-sidecar.exe",
        "to": "python-sidecar.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgenticERM",
      "artifactName": "AgenticERM_Desktop_Setup_${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "SimJaeSugn",
      "repo": "SimJaeSugn.github.io",
      "releaseType": "release"
    }
  }
}
